<div class="post-layout$layout_class">
  <header class="post-head">
    <p class="tc"><a href="$section_url">[$section_name]</a> $date</p>
    <h1>$title</h1>
    <div class="post-meta"><span>$reading_time</span>$meta_extra$model_html</div>
    $tags_html
    $source_html
  </header>
  $rail_html
  <article class="prose post-body">$body</article>
  <footer class="post-foot">
    <a href="$section_url">← // $section_name</a>
    <a href="/">首页</a>
  </footer>
</div>
